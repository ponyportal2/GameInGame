# Server Configuration
PORT=3000
HOST=0.0.0.0

# Optional Authentication (if set, requests must pass Bearer <key> or x-api-key: <key>)
# Leave empty to allow unauthenticated access for local development
API_KEY=

# Fake Timing Simulation (in milliseconds)
DEFAULT_DELAY_MS=500
STREAM_DELAY_MS=50
STREAM_CHUNK_STRATEGY=word

# Determinism
DETERMINISTIC=true
SEED=42

# CORS Configuration
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info
